# ---------------------------------------------------------------------------
# .gitignore — tells git which files to IGNORE (never track or commit).
# NOTE: This project has no build step, so there is very little to ignore.
# We only exclude OS junk files and editor folders.
# ---------------------------------------------------------------------------

# macOS / Windows / Linux junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE folders
.vscode/
.idea/
*.swp

# Logs
*.log

# ---------------------------------------------------------------------------
# SECRETS — never commit these. If you add a backend or API keys later,
# keep them in a .env file (ignored here) and load them at runtime.
# ---------------------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.p12
secrets.json
credentials.json

# Dependencies (if you ever add npm packages)
node_modules/

